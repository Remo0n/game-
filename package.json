{
  "name": "bento-blocks",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import tsx --test src/engine/geometry/shape.test.ts src/engine/geometry/cuts.test.ts src/engine/play/attempt.test.ts src/engine/scoring/score.test.ts src/engine/solver/solver.test.ts src/engine/generator/generateLevel.test.ts src/game/session.test.ts src/components/fitTarget.test.ts src/components/boardGeometry.test.ts src/game/progress.test.ts src/game/routes.test.ts scripts/dependency-compat.test.cjs src/engine/generator/progression.test.ts",
    "test:scale": "node --import tsx scripts/scale-report.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build:web": "expo export --platform web",
    "build:all": "expo export --platform all",
    "release:check": "node scripts/release-check.cjs",
    "preview:web": "node scripts/serve-web.cjs",
    "eas-build-post-install": "npm run check && npm run release:check",
    "postinstall": "node scripts/patch-query-string.cjs",
    "test:progression": "node --import tsx scripts/progression-report.ts"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.15",
    "expo-asset": "57.0.18"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
