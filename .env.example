# Public release identity. Decide these before publishing; never put secrets here.
EXPO_PUBLIC_DEVELOPER_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_WEBSITE_URL=
# Reverse-domain app ID you control, shared by iOS and Android (e.g. com.yourcompany.bentoblocks).
BENTO_APP_ID=
# UUID returned by EAS project setup, after signing in to your own Expo account.
EAS_PROJECT_ID=
